# Database
POSTGRES_USER=itip_user
POSTGRES_PASSWORD=replace-with-a-local-password-at-least-16-characters
POSTGRES_DB=itip_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application / API
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters

# Tracing (set an OTLP endpoint in deployed environments)
OTEL_SERVICE_NAME=itip-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORTER=false

# Region & Ingestion
TARGET_REGION_BBOX="-124.4,32.5,-114.1,42.0"
FIRMS_API_KEY=replace-with-firms-api-key

# External services
# Keep these values only in .env or your deployment secret manager.
MAP_API_KEY=575b468928a28dba51c38c81b233cf8e
WEATHER_API_KEY=9ecdd2d8d44b4018abc181443261209
